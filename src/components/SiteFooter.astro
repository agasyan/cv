---
import { lastContentCommitDate } from '../lib/git';
import { formatDay, pdfFileName, profileUrl, type ResumeVersion } from '../lib/resume';
import type { Downloads } from './SiteHeader.astro';

interface Props {
  current: ResumeVersion;
  downloads: Downloads;
}

const { current, downloads } = Astro.props;
// The last commit's date, so every new commit moves it; the version's month when git is unavailable.
const updated = lastContentCommitDate();
const link = 'inline-flex min-h-11 items-center underline-offset-4 hover:text-primary hover:underline';
---

<footer class="mx-auto max-w-5xl px-5 pt-8 pb-12 text-[0.9375rem] text-muted sm:px-4 print:hidden">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p>Updated {updated ? <time datetime={updated}>{formatDay(updated)}</time> : current.label}</p>
    <nav class="flex flex-wrap gap-x-6" aria-label="Footer">
      <a href={downloads.full} download={pdfFileName(current, 'full')} class={link}>Download PDF</a>
      <a href={downloads.compact} download={pdfFileName(current, 'compact')} class={link}>1-page PDF</a>
      <a href={profileUrl(current.data.profile.linkedin)} class={link} rel="me">LinkedIn</a>
    </nav>
  </div>
</footer>
