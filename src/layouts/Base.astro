---
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path of the canonical page; defaults to the current path. `false` omits the tag (e.g. 404). */
  canonical?: string | false;
  noindex?: boolean;
  /** Social preview image path. */
  image?: string;
  /** What the social preview image shows. */
  imageAlt?: string;
}

const { title, description, canonical = Astro.url.pathname, noindex = false, image, imageAlt } = Astro.props;
const canonicalUrl = canonical === false ? null : new URL(canonical, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {/* The browser bar sits on the sticky header, so it takes the header's base-100, not the page's base-200. */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2a2824" media="(prefers-color-scheme: dark)" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'paper' || theme === 'paper-dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh bg-base-200 text-base-content antialiased">
    <a href="#resume" class="skip-link btn h-11 min-h-11">Skip to content</a>
    <slot />
  </body>
</html>
